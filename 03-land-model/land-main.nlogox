    <slider x="802" step="1" y="52" max="0" width="197" display="par_elev_riftHeight" height="50" min="-500" direction="Horizontal" default="0.0" variable="par_elev_riftHeight" units="m"></slider>
    <monitor x="1278" precision="0" y="103" height="60" fontSize="9" width="109">elev_numRanges</monitor>
    <input x="1144" multiline="false" y="104" height="60" variable="par_elev_numRanges" type="number" width="131">1.0</input>
    <slider x="802" step=".01" y="220" max=".1" width="197" display="par_elev_smoothingRadius" height="50" min="0" direction="Horizontal" default="0.1" variable="par_elev_smoothingRadius"></slider>
    <monitor x="1002" precision="2" y="216" height="60" fontSize="9" width="140">elev_smoothingRadius</monitor>
    <monitor x="1002" precision="2" y="161" height="60" fontSize="9" width="140">elev_smoothStep</monitor>
    <slider x="802" step="0.01" y="165" max="1" width="197" display="par_elev_smoothStep" height="50" min="0" direction="Horizontal" default="1.0" variable="par_elev_smoothStep"></slider>
    <monitor x="1002" precision="2" y="47" height="60" fontSize="9" width="140">elev_riftHeight</monitor>
    <monitor x="1002" precision="2" y="104" height="60" fontSize="9" width="140">elev_rangeHeight</monitor>
    <slider x="802" step="1" y="106" max="500" width="197" display="par_elev_rangeHeight" height="50" min="0" direction="Horizontal" default="15.0" variable="par_elev_rangeHeight" units="m"></slider>
    <monitor x="889" precision="0" y="275" height="60" fontSize="9" width="178" display="smoothing neighborhood size"><![CDATA[(word (count patches with [ distance patch 0 0 < elev_smoothingRadius ] - 1) " patches")]]></monitor>
    <input x="1144" multiline="false" y="40" height="60" variable="par_elev_numRifts" type="number" width="131">1.0</input>
    <monitor x="1278" precision="0" y="40" height="60" fontSize="9" width="109">elev_numRifts</monitor>
    <slider x="799" step="1" y="344" max="360" width="207" display="par_elev_featureAngleRange" height="50" min="0" direction="Horizontal" default="5.0" variable="par_elev_featureAngleRange" units="º"></slider>
    <monitor x="1009" precision="0" y="336" height="60" fontSize="9" width="145">elev_featureAngleRange</monitor>
    <slider x="1392" step="1" y="108" max="100" width="230" display="par_elev_rangeLength" height="50" min="0" direction="Horizontal" default="100.0" variable="par_elev_rangeLength" units="% patches"></slider>
    <slider x="1392" step="1" y="46" max="100" width="230" display="par_elev_riftLength" height="50" min="0" direction="Horizontal" default="100.0" variable="par_elev_riftLength" units="% patches"></slider>
    <monitor x="1627" precision="0" y="104" height="60" fontSize="9" width="110">elev_rangeLength</monitor>
    <monitor x="1627" precision="0" y="39" height="60" fontSize="9" width="110">elev_riftLength</monitor>
    <slider x="1170" step="1" y="208" max="(par_elev_rangeHeight - par_elev_riftHeight) / 2" width="172" display="par_elev_noise" height="50" min="0" direction="Horizontal" default="1.0" variable="par_elev_noise" units="m"></slider>
    <monitor x="1344" precision="2" y="202" height="60" fontSize="9" width="100">elev_noise</monitor>
    <input x="1517" multiline="false" y="208" height="60" variable="par_elev_inversionIterations" type="number" width="167">5.0</input>
