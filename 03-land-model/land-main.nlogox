    <monitor x="1345" precision="0" y="261" height="60" fontSize="9" width="143">elev_numProtuberances</monitor>
    <input x="1171" multiline="false" y="319" height="60" variable="par_elev_numDepressions" type="number" width="172">1.0</input>
    <monitor x="1346" precision="0" y="319" height="60" fontSize="9" width="143">elev_numDepressions</monitor>
    <slider x="1170" step="0.01" y="382" max="1" width="198" display="par_elev_rangeAggregation" height="50" min="0" direction="Horizontal" default="0.75" variable="par_elev_rangeAggregation"></slider>
    <monitor x="1372" precision="4" y="440" height="60" fontSize="9" width="141">elev_riftAggregation</monitor>
    <slider x="1170" step=".01" y="440" max="1" width="198" display="par_elev_riftAggregation" height="50" min="0" direction="Horizontal" default="0.9" variable="par_elev_riftAggregation"></slider>
    <monitor x="1372" precision="4" y="378" height="60" fontSize="9" width="141">elev_rangeAggregation</monitor>
    <chooser x="892" y="404" height="60" variable="elev_algorithm-style" current="1" width="184" display="elev_algorithm-style">
      <choice type="string" value="NetLogo"></choice>
      <choice type="string" value="C#"></choice>
    </chooser>
    <note x="1514" y="182" backgroundDark="0" fontSize="12" width="216" markdown="false" height="25" textColorDark="-1" textColorLight="-16777216" backgroundLight="0">used when algorithm-style = NetLogo</note>
    <note x="1231" y="182" backgroundDark="0" fontSize="12" width="183" markdown="false" height="24" textColorDark="-1" textColorLight="-16777216" backgroundLight="0">used when algorithm-style = C#</note>
    <slider x="45" step="1" y="143" max="max-pxcor" width="486" display="xTransect" height="50" min="min-pxcor" direction="Horizontal" default="0.0" variable="xTransect"></slider>
    <slider x="4" step="1" y="183" max="max-pycor" width="50" display="yTransect" height="478" min="min-pycor" direction="Vertical" default="0.0" variable="yTransect"></slider>
