      <choice type="string" value="cover type"></choice>
    </chooser>
    <slider x="276" step="1" y="90" max="round max (list maxElevation par_elev_rangeHeight)" width="150" display="par_seaLevel" height="50" min="round min (list minElevation par_elev_riftHeight)" direction="Horizontal" default="-3.0" variable="par_seaLevel" units="m"></slider>
    <button x="191" actionKey="2" y="100" height="35" disableUntilTicks="false" forever="false" kind="Observer" width="72" display="refresh">refresh-view</button>
