      </pen>
    </plot>
    <plot x="27" autoPlotX="true" yMax="10.0" autoPlotY="true" yAxis="m" y="658" xMin="0.0" height="148" legend="false" xMax="10.0" yMin="0.0" width="496" xAxis="pxcor" display="Horizontal transect">
      <setup></setup>
