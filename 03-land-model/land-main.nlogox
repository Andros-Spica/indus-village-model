    <slider x="783" step="1" y="761" max="par_soil_maxDepth - 1" width="180" display="par_soil_minDepth" height="50" min="0" direction="Horizontal" default="0.0" variable="par_soil_minDepth" units="mm"></slider>
    <slider x="781" step="0.01" y="885" max="3" width="241" display="par_soil_formativeErosionRate" height="50" min="0" direction="Horizontal" default="0.68" variable="par_soil_formativeErosionRate"></slider>
    <slider x="783" step="1" y="817" max="100" width="180" display="par_soil_depthNoise" height="50" min="0" direction="Horizontal" default="45.0" variable="par_soil_depthNoise" units="mm"></slider>
