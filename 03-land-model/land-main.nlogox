      <choice type="string" value="random"></choice>
      <choice type="string" value="user-defined"></choice>
      <choice type="string" value="defined by expNumber"></choice>
    </chooser>
    <button x="610" y="24" height="35" disableUntilTicks="false" forever="false" kind="Observer" width="152" display="parameters to default">parameters-to-default</button>
    <button x="206" y="9" height="35" disableUntilTicks="false" forever="false" kind="Observer" width="110">export-terrain</button>
    <button x="218" actionKey="9" y="47" height="35" disableUntilTicks="false" forever="false" kind="Observer" width="196" display="export-random-terrain (100x)">repeat 100 [ export-random-terrain ]</button>
    <button x="319" y="9" height="35" disableUntilTicks="false" forever="false" kind="Observer" width="108" display="import-terrain">import-terrain
setup-patch-coordinates-labels "bottom" "left"
setup-transect
update-transects
update-plots</button>
