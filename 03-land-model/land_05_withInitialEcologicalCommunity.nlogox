    <monitor x="1002" precision="2" y="47" height="60" fontSize="9" width="140">elev_riftHeight</monitor>
    <monitor x="1002" precision="2" y="104" height="60" fontSize="9" width="140">elev_rangeHeight</monitor>
    <slider x="802" step="1" y="106" max="500" width="197" display="par_elev_rangeHeight" height="50" min="0" direction="Horizontal" default="15.0" variable="par_elev_rangeHeight" units="m"></slider>
    <monitor x="889" precision="0" y="275" height="60" fontSize="9" width="178" display="smoothing neighborhood size"><![CDATA[(word (count patches with [ distance patch 0 0 < elev_smoothingRadius ] - 1) " patches")]]></monitor>
