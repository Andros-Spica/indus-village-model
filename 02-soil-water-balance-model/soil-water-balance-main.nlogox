    <slider x="30" step="0.001" y="1214" max="0.03" width="479" display="precipitation_daily-cum_rate1_yearly-sd" height="50" min="0.004" direction="Horizontal" default="0.02" variable="precipitation_daily-cum_rate1_yearly-sd" units="(default: 0.02)"></slider>
