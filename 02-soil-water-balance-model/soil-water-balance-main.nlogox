    <slider x="834" step="1" y="1117" max="100" width="492" display="precipitation_daily-cum_inflection2_yearly-sd" height="50" min="20" direction="Horizontal" default="20.0" variable="precipitation_daily-cum_inflection2_yearly-sd" units="days (default: 20)"></slider>
