    <slider x="949" step="0.1" y="260" max="15" width="371" display="temperature_annual-min-at-2m" height="50" min="-15" direction="Horizontal" default="12.8" variable="temperature_annual-min-at-2m" units="ºC  (default: 12.8)"></slider>
