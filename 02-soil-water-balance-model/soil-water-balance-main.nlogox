    <plot x="285" autoPlotX="true" yMax="10.0" autoPlotY="true" yAxis="ºC" y="204" xMin="0.0" height="191" legend="true" xMax="10.0" yMin="0.0" width="656" xAxis="days" display="Temperature">
      <setup></setup>
