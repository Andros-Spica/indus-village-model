    <monitor x="1360" precision="2" y="978" height="60" fontSize="9" width="301">precipitation_dailyCum_maxSampleSize_yearlySd</monitor>
    <slider x="949" step="1" y="870" max="10" width="408" display="precipitation_daily-cum_n-samples_yearly-sd" height="50" min="1" direction="Horizontal" default="5.0" variable="precipitation_daily-cum_n-samples_yearly-sd" units="(default: 5)"></slider>
    <slider x="949" step="1.0" y="814" max="300" width="408" display="precipitation_daily-cum_n-samples_yearly-mean" height="50" min="0" direction="Horizontal" default="200.0" variable="precipitation_daily-cum_n-samples_yearly-mean" units="(default: 200)"></slider>
    <slider x="954" step="0.1" y="740" max="250" width="402" display="precipitation_yearly-sd" height="50" min="0" direction="Horizontal" default="142.2" variable="precipitation_yearly-sd" units="mm/year (default: 142.2)"></slider>
