to apply-mortality

  ask households
  [
    hh_update-members-survival
  ]

end

to hh_update-members-survival

  ; applies age-specific mortality rates and delete dying members

  ; get a list with true/false values flagging which members is dying during the current day
  let dying? hh_whichMembersDying

  ; iterate for the members from last to first, eliminating those that should be dying
  let memberIndex (hh_count-members) - 1
  repeat hh_count-members
  [
    if (item memberIndex dying?)
    [
      ; add to mortality
      ifelse (item memberIndex hh_membersSex)
      [ set womenDeathsToday womenDeathsToday + 1 ]
      [ set menDeathsToday menDeathsToday + 1 ]

      if (hh_tellYourStory) [ print (word "Member " memberIndex " from " self " dies with age " (item memberIndex hh_membersAge) ".") ]

      hh_delete-member memberIndex
    ]
    set memberIndex memberIndex - 1
  ]

  hh_update-marriages-after-deaths

end

to-report hh_whichMembersDying

  let densityEffect get-density-effect-of-day

  ; returns a list with true/false values flagging which members is dying during the current day
  report map
  [
    memberIndex ->
    (random-float 1 < get-mortality-prob-of-day (item memberIndex hh_membersSex) (item memberIndex hh_membersAge) densityEffect)
  ] hh_membersIndexes

end

to hh_update-marriages-after-deaths

  ; update hh_membersMarriage to consider any widow/widower as single
  foreach hh_membersIndexes
  [
    memberIndex ->
    if (item memberIndex hh_membersMarriage != -1                                           ; if the member is married
      and length filter [j -> j = item memberIndex hh_membersMarriage] hh_membersMarriage = 1) ; and her/his partner died this day (so she/he is the only member with the marriage index)
    [
      set hh_membersMarriage replace-item memberIndex hh_membersMarriage -1

      if (hh_tellYourStory) [ print (word "Member " memberIndex " of " self " has lost her/his partner.") ]
    ]
  ]

end

to-report get-mortality-prob-of-day [ isFemale ageInDays densityEffect ]

  let ageInYears get-age-in-years-old ageInDays

  let probDying (get-mortality-prob-from-table isFemale ageInYears)

  set probDying 1 - (1 - probDying) ^ (1 / year-length-in-days)

  report clamp01 (probDying + densityEffect)

end

to-report get-mortality-prob-from-table [ isFemale age ]

  let probDying 1

  ifelse (age < length nuptialityTable-women) 
  [
    ifelse (isFemale)
    [
      set probDying item age mortalityTable-women
    ]
    [
      set probDying item age mortalityTable-men
    ]
  ]
  [
    print (word "WARNING: individual with age higher than " (length nuptialityTable-women) " (" age ") detected in " self)
  ]

  report probDying

end

to-report get-density-effect-of-day

  let densityEffect get-density-effect
  
  set densityEffect clamp01 densityEffect

  let densityEffectOfDay 1 - (1 - densityEffect) ^ (1 / year-length-in-days)

  report densityEffectOfDay

end

to-report get-density-effect

  ;;; Get a nutrition score as a function of the current population size and the carrying capacity (and a power that sets the shape of the relationship.
  ;;; NOTE: this function is a rough approximation of the combined outcomes of the Nutrition and Food Storage model and is to be replaced in the integrated version.

  let numberOfPeople sum ([length hh_membersAge] of households)

  ; For example, in https://www.wolframalpha.com/, use:
  ;plot 0.05*((x - 200) / 200) ^ 3 for x=1..1000
  let densityEffect density-effect-scaling-factor * (numberOfPeople / carrying-capacity) ^ density-effect-steepness

  report densityEffect

end
