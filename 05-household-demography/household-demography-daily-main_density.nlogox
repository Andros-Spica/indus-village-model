          <line endX="90" startY="150" marked="true" color="-1920102913" endY="180" startX="150"></line>
          <line endX="210" startY="150" marked="true" color="-1920102913" endY="180" startX="150"></line>
        </shape>
      </indicator>
    </shape>
  </linkShapes>
  <previewCommands>setup repeat 75 [ go ]</previewCommands>
  <experiments>
    <experiment name="exp-trajectories" repetitions="1" sequentialRunOrder="true" runMetricsEveryStep="true">
      <setup>setup</setup>
      <go>go</go>
      <metrics>
        <metric>max-iterations</metric>
        <metric>max-population</metric>
        <metric>maturity-age-in-years</metric>
        <metric>gestation-period-in-days</metric>
        <metric>year-length-in-days</metric>
        <metric>max-iterations-in-days</metric>
        <metric>density-effect-steepness</metric>
        <metric>initial-num-households</metric>
        <metric>household-initial-age-distribution</metric>
        <metric>max-couple-count-distribution</metric>
        <metric>carrying-capacity</metric>
        <metric>density-effect-scaling-factor</metric>
        <metric>cdmlt-level</metric>
        <metric>coale-demeny-region</metric>
        <metric>amenorrhea-period-in-days</metric>
        <metric>c1-fert</metric>
        <metric>mu-fert</metric>
        <metric>sigma1-fert</metric>
        <metric>sigma2-fert</metric>
        <metric>acceptable-kinship-degree-for-couples</metric>
        <metric>c1-women</metric>
        <metric>c1-men</metric>
        <metric>mu-women</metric>
        <metric>mu-men</metric>
        <metric>sigma1-women</metric>
        <metric>sigma1-men</metric>
        <metric>sigma2-women</metric>
        <metric>sigma2-men</metric>
        <metric>totalHouseholds</metric>
        <metric>totalIndividuals</metric>
        <metric>totalIndividualsLastYear</metric>
        <metric>totalPopulationGrowth</metric>
        <metric>totalWomen</metric>
        <metric>totalMen</metric>
        <metric>femaleRatio</metric>
        <metric>womenAgeStructure</metric>
        <metric>menAgeStructure</metric>
        <metric>womenFirstAgeGroup</metric>
        <metric>menFirstAgeGroup</metric>
        <metric>womenBirthsToday</metric>
        <metric>womenBirthsThisYear</metric>
        <metric>womenBirthsLastYear</metric>
        <metric>menBirthsToday</metric>
        <metric>menBirthsThisYear</metric>
        <metric>menBirthsLastYear</metric>
        <metric>womenDeathsToday</metric>
        <metric>womenDeathsThisYear</metric>
        <metric>womenDeathsLastYear</metric>
        <metric>menDeathsToday</metric>
        <metric>menDeathsThisYear</metric>
        <metric>menDeathsLastYear</metric>
        <metric>womenInToday</metric>
        <metric>womenInThisYear</metric>
        <metric>womenInLastYear</metric>
        <metric>menInToday</metric>
        <metric>menInThisYear</metric>
        <metric>menInLastYear</metric>
        <metric>womenOutToday</metric>
        <metric>womenOutThisYear</metric>
        <metric>womenOutLastYear</metric>
        <metric>menOutToday</metric>
        <metric>menOutThisYear</metric>
        <metric>menOutLastYear</metric>
        <metric>couplesAcceptedToday</metric>
        <metric>couplesAcceptedThisYear</metric>
        <metric>couplesAcceptedLastYear</metric>
        <metric>couplesRejectedToday</metric>
        <metric>couplesRejectedThisYear</metric>
        <metric>couplesRejectedLastYear</metric>
        <metric>totalOrphans</metric>
        <metric>stopCondition</metric>
      </metrics>
      <constants>
        <enumeratedValueSet variable="type-of-experiment">
          <value value="&quot;user-defined&quot;"></value>
        </enumeratedValueSet>
        <steppedValueSet variable="SEED" first="0" step="1" last="49"></steppedValueSet>
        <enumeratedValueSet variable="max-iterations">
          <value value="500"></value>
        </enumeratedValueSet>
        <enumeratedValueSet variable="max-population">
