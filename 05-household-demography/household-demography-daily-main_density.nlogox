        <update>carefully [ plot max [hh_count-couples] of households ] [ ]</update>
      </pen>
      <pen interval="1.0" mode="0" display="count min" color="-12345184" legend="true">
        <setup></setup>
        <update>carefully [ plot min [hh_count-couples] of households ] [ ]</update>
      </pen>
    </plot>
    <plot x="666" autoPlotX="true" yMax="10.0" autoPlotY="true" y="512" xMin="0.0" height="167" legend="true" xMax="10.0" yMin="0.0" width="464" display="Households">
      <setup></setup>
      <update></update>
