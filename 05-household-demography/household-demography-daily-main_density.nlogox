    <monitor x="1247" precision="4" y="107" height="60" fontSize="11" width="100">femaleRatio</monitor>
    <plot x="1134" autoPlotX="true" yMax="10.0" autoPlotY="true" yAxis="mean members age" y="882" xMin="0.0" height="262" legend="false" xMax="10.0" yMin="0.0" width="290" xAxis="members count" display="Household structure">
