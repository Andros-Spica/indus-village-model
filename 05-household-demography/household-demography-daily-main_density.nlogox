    <plot x="669" autoPlotX="true" yMax="10.0" autoPlotY="true" y="882" xMin="0.0" height="263" legend="true" xMax="10.0" yMin="0.0" width="461" display="Age structure (population)">
      <setup>set-histogram-num-bars 20
set-plot-x-range -1 max (sentence womenAgeStructure menAgeStructure)</setup>
      <update>set-plot-y-range 0 10
;set-histogram-num-bars 20
carefully [ set-plot-x-range -1 max (sentence womenAgeStructure menAgeStructure) ] [ ]</update>
      <pen interval="1.0" mode="1" display="women" color="-2674135" legend="true">
        <setup></setup>
