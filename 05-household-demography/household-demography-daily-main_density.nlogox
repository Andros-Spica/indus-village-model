__includes [
  "modules/_setup_and_go_daily_density.nls" ; ---
  "modules/age-households.nls"
  "modules/apply-fertility_daily.nls" ; ---
  "modules/apply-nuptiality_daily.nls" ; ---
  "modules/apply-mortality_daily_density.nls" ; ---
  "modules/manage-orphanhood_daily.nls" ; ---
  "modules/hh_init_daily.nls" ; ---
  "modules/hh_utils_daily.nls" ; ---
  "modules/kinship.nls"
  "modules/fertility-nuptiality_peristera-kostaki.nls"
  "modules/mortality_coale-demeny.nls"
  "modules/output-stats_daily.nls" ; ---
  "modules/experiments_daily_density.nls"
  "../utils/time.nls"
  "../utils/plot-table.nls"
  "../utils/clamp.nls"
]

;;;;;;;;;;;;;;;;;
;;;;; BREEDS ;;;;
;;;;;;;;;;;;;;;;;

breed [ households household ]

;;;;;;;;;;;;;;;;;
;;; VARIABLES ;;;
;;;;;;;;;;;;;;;;;

globals
[
  ;;; constants
  maturity-age-in-years              ; defaults to 15 years old; it affects the minimum age acceptable for individuals to keep a household without older individuals
  gestation-period-in-days           ; assumed here as a constant fixed at 280
  year-length-in-days
  max-iterations-in-days
  
  density-effect-steepness

  ;;; demography tables
  fertilityTable
  nuptialityTable-women nuptialityTable-men
  mortalityTable-women mortalityTable-men

  ;;; modified parameters
  initial-num-households
  household-initial-age-distribution ; (list minimum maximum)
  max-couple-count-distribution      ; (list minimum maximum)
  acceptable-kinship-degree-for-couples ; degree of kinship acceptable between two individuals forming a new couple (1 = same household, 0.5 = level one relationship, etc.)
  amenorrhea-period-in-days          ; length in days of the postpartum amenorrhea periodInDays
  ; value guide: 23 (3 weeks, minimal), 42 (6 weeks, if not lactating), 180 (6 months or 24 weeks, average), 540 (18 months or 64 weeks, intentional delay, medical recommendation)

  carrying-capacity               ; carrying capacity or maximum number of people that can be sustained feed, i.e. mortality is increased in proportion to closeness of population to it (density effect)
  density-effect-scaling-factor     ; the maximum additional death probability (scaling factor for density-dependent mortality)

  ;;; variables
  ;;;; time tracking
  currentYear
  currentDayOfYear

  ;;;; auxiliar
  ; these are lists of string-coded individuals
  womenToMarry                   ; single individuals selected to marry ("<household who> <member index>")
  menToMarry
  orphanList                     ; orphan children left without adults ("<sex> <age>")
  densityEffect

  ;;;; counters and final measures
  totalHouseholds                ; count households (integer)
  totalIndividuals               ; sum of members of households (integer)
  totalIndividualsLastYear
  totalPopulationGrowth          ; % of last year's totalIndividuals
  totalWomen                     ; sum of female members of households (integer)
  totalMen                       ; sum of male members of households (integer)
  femaleRatio                    ; total number of women over total number of individuals (float)
  womenAgeStructure              ; merge list of all households female members ages (list of integers)
  menAgeStructure                ; merge list of all households male members ages (list of integers)
  womenFirstAgeGroup             ; count of women with age from 0 to 4 years old (base of typical population pyramid) (integer)
  menFirstAgeGroup               ; count of men with age from 0 to 4 years old (base of typical population pyramid) (integer)
  womenBirthsToday               ; number of births (integer)
  womenBirthsThisYear
  womenBirthsLastYear
  menBirthsToday
  menBirthsThisYear
  menBirthsLastYear
  womenDeathsToday                    ; number of deaths (integer)
  womenDeathsThisYear
  womenDeathsLastYear
  menDeathsToday
  menDeathsThisYear
  menDeathsLastYear
  womenInToday                        ; number of individuals entering the system (generated for couple creation with external population) (integer)
  womenInThisYear
  womenInLastYear
  menInToday
  menInThisYear
  menInLastYear
  womenOutToday                       ; number of individuals exiting the system (due to couple creation with external population) (integer)
  womenOutThisYear
  womenOutLastYear
  menOutToday
  menOutThisYear
  menOutLastYear
  couplesAcceptedToday           ; number of couples formed (integer)
  couplesAcceptedThisYear
  couplesAcceptedLastYear
  couplesRejectedToday           ; number of couples rejected due to tabu restrictions (integer)
  couplesRejectedThisYear
  couplesRejectedLastYear
  totalOrphans                   ; number of children moving from an household where all adults are dead
  stopCondition                  ; registry of condition met causing simulation to halt
]

;;; agents variables

households-own
[
  hh_lineage                     ; identifier of the lineage history of a household (list of integers; integers are household 'who's)
  hh_age                         ; number of days during which the household existed (integer)
  hh_maxCoupleCount              ; max. number of couples accepted within a household (integer)
  hh_membersAge                  ; ages of every household member in days (list of integer)
  hh_membersSex                  ; sex of every household member (list of true/false, i.e. is female?)
  hh_membersMarriage             ; couple index of every member (list of integers; 0-Inf: couple index, -1: member is single)
  hh_membersGestation            ; whether members are female and currently in the gestation or pregnancy period
  hh_membersAmenorrhea            ; whether members are female and currently in postpartum amenorrhea period

  ;;; auxiliar
  hh_memberIndexesToDelete

  hh_tellYourStory
]
]]></code>
  <widgets>
    <view x="343" wrappingAllowedX="true" y="13" frameRate="30.0" minPycor="-9" height="308" showTickCounter="true" patchSize="16.0" fontSize="10" wrappingAllowedY="true" width="308" tickCounterLabel="ticks" maxPycor="9" updateMode="0" maxPxcor="9" minPxcor="-9"></view>
    <button x="274" actionKey="5" y="11" height="40" disableUntilTicks="false" forever="true" kind="Observer" width="55">go</button>
    <button x="77" actionKey="2" y="11" height="40" disableUntilTicks="false" forever="false" kind="Observer" width="55">go</button>
    <button x="18" actionKey="1" y="11" height="40" disableUntilTicks="false" forever="false" kind="Observer" width="55">setup</button>
    <button x="135" actionKey="3" y="11" height="40" disableUntilTicks="false" forever="false" kind="Observer" width="59" display="+ year">repeat 365 [ go ]</button>
    <button x="199" actionKey="4" y="11" height="40" disableUntilTicks="false" forever="false" kind="Observer" width="72" display="+ 25 years">repeat 25 * 365 [ go ]</button>
    <plot x="666" autoPlotX="true" yMax="10.0" autoPlotY="true" y="266" xMin="0.0" height="242" legend="true" xMax="10.0" yMin="0.0" display="Births and deaths (last year)" width="464" sizeVersion="0">
      <setup></setup>
      <update></update>
      <pen interval="1.0" mode="1" display="women deaths" color="-1604481" legend="true">
        <setup></setup>
        <update>if (currentDayOfYear = year-length-in-days) [ plot -1 * womenDeathsLastYear ]</update>
      </pen>
      <pen interval="1.0" mode="1" display="women births" color="-5298144" legend="true">
        <setup></setup>
        <update>if (currentDayOfYear = year-length-in-days) [ plot womenBirthsLastYear ]</update>
      </pen>
      <pen interval="1.0" mode="1" display="men births" color="-14070903" legend="true">
        <setup></setup>
        <update>if (currentDayOfYear = year-length-in-days) [ plot womenBirthsLastYear + menBirthsLastYear ]</update>
      </pen>
      <pen interval="1.0" mode="1" display="men deaths" color="-8020277" legend="true">
        <setup></setup>
        <update>if (currentDayOfYear = year-length-in-days) [ plot -1 * (womenDeathsLastYear + menDeathsLastYear) ]</update>
      </pen>
      <pen interval="1.0" mode="0" display="0" color="-7500403" legend="true">
        <setup></setup>
        <update>if (currentDayOfYear = year-length-in-days) [ plot 0 ]</update>
      </pen>
    </plot>
    <monitor x="668" precision="4" y="207" height="60" fontSize="11" width="155" display="women immigration rate">womenInLastYear / totalWomen</monitor>
    <monitor x="831" precision="4" y="207" height="60" fontSize="11" width="140" display="women emigration rate">womenOutLastYear / totalWomen</monitor>
    <monitor x="979" precision="4" y="207" height="60" fontSize="11" width="134" display="men immigration rate">menInLastYear / totalMen</monitor>
    <monitor x="1120" precision="4" y="207" height="60" fontSize="11" width="135" display="men emigration rate">menOutLastYear / totalMen</monitor>
    <monitor x="1142" precision="2" y="44" height="60" fontSize="14" width="210" display="total population growth (% last year)">totalPopulationGrowth</monitor>
    <monitor x="1143" precision="0" y="106" height="60" fontSize="11" width="100" display="orphans count">totalOrphans</monitor>
    <monitor x="1140" precision="4" y="304" height="60" fontSize="11" width="114" display="women birth rate">womenBirthsLastYear / totalWomen</monitor>
    <monitor x="1258" precision="4" y="304" height="60" fontSize="11" width="100" display="men birth rate">menBirthsLastYear / totalMen</monitor>
    <monitor x="1141" precision="4" y="367" height="60" fontSize="11" width="113" display="women death rate">womenDeathsLastYear / totalWomen</monitor>
    <monitor x="1259" precision="4" y="367" height="60" fontSize="11" width="100" display="men death rate">menDeathsLastYear / totalMen</monitor>
    <plot x="666" autoPlotX="true" yMax="10.0" autoPlotY="true" y="684" xMin="0.0" height="195" legend="true" xMax="10.0" yMin="0.0" width="464" display="maxCoupleCount and actual count">
      <setup>set-plot-y-range -1 (1 + item 1 max-couple-count-distribution)</setup>
      <update></update>
