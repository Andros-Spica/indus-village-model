      </pen>
    </plot>
    <monitor x="1279" precision="2" y="799" height="60" fontSize="11" width="100" display="% 0-4 (men)">100 * menFirstAgeGroup / totalMen</monitor>
    <monitor x="1177" precision="2" y="800" height="60" fontSize="11" width="100" display="% 0-4 (women)">100 * womenFirstAgeGroup / totalWomen</monitor>
