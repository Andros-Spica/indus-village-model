    <plot x="627" autoPlotX="true" yMax="10.0" autoPlotY="true" yAxis="stock units" y="402" xMin="0.0" height="191" legend="true" xMax="10.0" yMin="0.0" width="415" xAxis="time steps" display="Household diet">
      <setup></setup>
